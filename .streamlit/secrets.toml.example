# Copier en .streamlit/secrets.toml (jamais versionné) ou coller dans les « Secrets » de Streamlit Cloud.
# Sans cette section, l'application reste en mode maquette (aucun enregistrement serveur).
[supabase]
url = "https://<identifiant-du-projet>.supabase.co"
cle_publique = "sb_publishable_..."

# Lecture des rapports de diagnostic par IA (mode « diagnostic existant »), facultatif.
# Clé à créer sur la console Claude d'Anthropic ; ne jamais la mettre dans le dépôt.
[anthropic]
cle = "sk-ant-..."
# modele = "claude-sonnet-5-5"
